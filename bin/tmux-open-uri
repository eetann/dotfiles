#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1090
source ~/dotfiles/bin/tmux-open-uri.local.sh

url="$1"
cwd="$(tmux display-message -p '#{pane_current_path}')"

host="${url#*://}"
host="${host%%/*}"
host="${host%%:*}"

is_localhost=false
if [[ "$host" == "localhost" || "$host" == *.localhost ]]; then
  is_localhost=true
fi

for work_path in "${WORK_PATHS[@]}"; do
  if [[ "$cwd" == "$work_path"* && "$is_localhost" == true ]]; then
    open -a "Google Chrome" "$url"
    exit 0
  fi
done

open -a "Zen" "$url"
